  "releases": [
    {
      "message": "* Video overlays on Android and iOS no longer consume touch input. Games can now react to taps during playback—for example, to implement tap-to-skip using `videoplayer.destroy(handle)`.\n* Fixed iOS builds with recent Xcode toolchains.\n* Improved playback stability on Apple platforms during hide/show and background/foreground transitions.\n* Prevented late Android callbacks after a video has been destroyed.\n* Added Android R8 keep rules for minified release builds.\n* Updated the example and API documentation.\n\nThanks to [@romancolaneri](https://github.com/romancolaneri) for contributing touch pass-through support in [#24](https://github.com/defold/extension-videoplayer-native/pull/24)!",
      "min_defold_version": "1.13.1",
      "published_at": "2026-09-04T11:36:28Z",
      "tag": "1.4.0",
      "zip": "https://github.com/defold/extension-videoplayer-native/archive/refs/tags/1.4.0.zip"
    },
